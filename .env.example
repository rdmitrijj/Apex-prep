# Copy to .env (never commit .env). Every variable the app reads is listed here.

# Postgres. Local default matches docker-compose. On Render: Neon *pooled* URL (host has "-pooler").
# Neon's ?sslmode=require&channel_binding=require params are fine; the app normalizes them for asyncpg.
DATABASE_URL=postgresql://apex:apex@localhost:5432/apex
# Optional: Neon *direct* (non-pooled) URL. Alembic migrations use it when set; otherwise DATABASE_URL.
DATABASE_URL_DIRECT=

# JWT signing key, 32+ random characters. Required in production (generate: python -c "import secrets; print(secrets.token_urlsafe(48))").
SECRET_KEY=
# "true" while you create your account, then "false" to lock sign-ups.
ALLOW_REGISTRATION=true

# Optional (milestone 3): Reading & Writing question generation. Without a key the app uses the seed bank only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: Desmos graphing calculator (build-time). Without it a built-in scientific calculator is used.
VITE_DESMOS_API_KEY=

# Tests only: database the backend test suite creates and wipes.
TEST_DATABASE_URL=postgresql://apex:apex@localhost:5432/apex_test
